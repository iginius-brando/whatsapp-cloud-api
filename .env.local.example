# =========================================================================
# Copia questo file in ".env.local" e compila i valori per lo sviluppo locale.
# In produzione (Firebase App Hosting) i valori vengono forniti da apphosting.yaml
# e da Cloud Secret Manager per i segreti. NON committare mai .env.local.
# =========================================================================

# --- Firebase (client, PUBBLICI) ---------------------------------------
# Li trovi in: Firebase Console > Impostazioni progetto > Le tue app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) -------------------------------------------
# In LOCALE: scarica una chiave service account dal progetto Firebase e imposta
# GOOGLE_APPLICATION_CREDENTIALS con il percorso al file JSON.
# In PRODUZIONE su App Hosting NON serve: vengono usate le credenziali di default.
GOOGLE_APPLICATION_CREDENTIALS=

# --- WhatsApp Cloud API (Meta, SEGRETI) --------------------------------
# Da Meta for Developers > la tua app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WABA): serve per leggere i template approvati.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token a tua scelta: lo stesso valore va inserito nella configurazione del webhook su Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# "App secret" da Meta > Impostazioni app > Base. Usato per verificare la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Versione delle Graph API (opzionale, default v22.0)
WHATSAPP_GRAPH_API_VERSION=v22.0

# --- Manutenzione periodica (SEGRETO) ----------------------------------
# Token con cui Cloud Scheduler chiama POST /api/whatsapp/maintenance
# (header "x-maintenance-token"): rielabora gli eventi del webhook rimasti in
# coda e archivia su Storage gli allegati non ancora copiati. Genera un valore
# casuale, per esempio con: openssl rand -base64 32
# Senza questo valore l'endpoint risponde 503 e la manutenzione non parte.
WHATSAPP_MAINTENANCE_TOKEN=
# Bucket di Storage per gli allegati archiviati. Di norma non serve: viene usato
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET. Compilalo solo per puntare a un bucket diverso.
FIREBASE_STORAGE_BUCKET=

# --- Embedded Signup (onboarding clienti come tech provider) -----------
# App ID della tua app Meta. Serve anche al browser, quindi è pubblico.
NEXT_PUBLIC_META_APP_ID=
# App secret usato per scambiare il "code" dell'Embedded Signup. Se non lo
# imposti viene usato WHATSAPP_APP_SECRET, che di norma è lo stesso valore.
META_APP_SECRET=
# ID della configurazione "Facebook Login for Business" con variante Embedded
# Signup (Meta for Developers > la tua app > Accesso Facebook per le aziende >
# Configurazioni).
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Versione dell'SDK JS di Facebook usata dal flusso (default v22.0).
NEXT_PUBLIC_META_GRAPH_API_VERSION=v22.0
# Versione delle informazioni di sessione: "3" per le configurazioni attuali,
# "none" per le configurazioni v4, dove ogni scelta sta nella configurazione di
# login e l'oggetto extras va lasciato vuoto.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_SESSION_INFO_VERSION=3
# Solo per l'onboarding in coesistenza con l'app WhatsApp Business:
# "whatsapp_business_app_onboarding". Vuoto per il flusso standard.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_FEATURE_TYPE=
# Passphrase con cui cifrare a riposo i token dei clienti su Firestore.
# Senza questo valore i token vengono salvati in chiaro.
WHATSAPP_TENANT_TOKEN_SECRET=

# --- WhatsApp Flows ----------------------------------------------------
# ID del Flow da inviare (WhatsApp Manager > Account Tools > Flows).
WHATSAPP_FLOW_ID=
# "true" finché il Flow è in bozza: consente l'invio ai soli numeri di test.
WHATSAPP_FLOW_DRAFT_MODE=false
# Chiave privata RSA 2048 usata per decifrare le richieste al Flow Endpoint.
# PEM completo; nelle variabili d'ambiente puoi usare "\n" al posto degli a capo.
WHATSAPP_FLOW_PRIVATE_KEY=
# Passphrase della chiave privata (obbligatoria: Meta richiede una chiave cifrata).
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
